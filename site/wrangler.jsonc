{
  // Cloudflare Workers static-assets config: serve the built site.
  // worker.js runs first for the videos only, to add Range/206 support
  // that static assets lack (Safari requires it for seekable video).
  "name": "ldorvador-preview",
  "compatibility_date": "2026-08-01",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ldorvador-interest",
      "database_id": "5da26daa-db41-405d-8740-3d15509be27a"
    }
  ],
  "vars": {
    "NOTIFY_TO": "connect@ldorvadortravel.com,erik@tcstudio.io",
    // ACCESS_TEAM_DOMAIN and ACCESS_AUD: fill in once Erik creates the
    // Cloudflare Access app protecting /api/interest/* exports. Left blank
    // means the export endpoint fails closed (always 404).
    "ACCESS_TEAM_DOMAIN": "tcstudio.cloudflareaccess.com",
    "ACCESS_AUD": "f4d00354389fef8f3283be0cfb5fc7b18efe41c73f54581ebce7a8be4c86d7c3"
  }
}
