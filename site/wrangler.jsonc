{
  // Cloudflare Workers static-assets config: serve the built site.
  // worker.js runs first for the videos only, to add Range/206 support
  // that static assets lack (Safari requires it for seekable video).
  "name": "ldorvador-preview",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ldorvador-interest",
      "database_id": "5da26daa-db41-405d-8740-3d15509be27a"
    }
  ],
  // Renders /groups/<slug>/trip-details.pdf on demand from print.html.
  // Free plan: 10 browser-minutes/day, 3 concurrent, 60s timeout — the
  // worker caches aggressively in PDF_CACHE, keyed by print.html's ETag.
  "browser": {
    "binding": "BROWSER"
  },
  "kv_namespaces": [
    {
      "binding": "PDF_CACHE",
      "id": "4d7655bd229b46de895a35756bd52148"
    }
  ],
  "vars": {
    "NOTIFY_TO": "connect@ldorvadortravel.com",
    // ACCESS_TEAM_DOMAIN and ACCESS_AUD: fill in once Erik creates the
    // Cloudflare Access app protecting /api/interest/* exports. Left blank
    // means the export endpoint fails closed (always 404).
    "ACCESS_TEAM_DOMAIN": "tcstudio.cloudflareaccess.com",
    "ACCESS_AUD": "f4d00354389fef8f3283be0cfb5fc7b18efe41c73f54581ebce7a8be4c86d7c3"
  },
  // Staging: its own Worker, D1 and Access app on staging.ldorvadortravel.com.
  // Build with PROD=0 SITE=https://staging.ldorvadortravel.com LDV_BOOKINGS_FORCE_OPEN=1
  // then `npx wrangler deploy --env staging`. Secrets are per environment:
  // `npx wrangler secret put <NAME> --env staging`. See DEPLOY.md.
  "env": {
    "staging": {
      "name": "ldorvador-staging",
      "routes": [{ "pattern": "staging.ldorvadortravel.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ldorvador-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_ID"
        }
      ],
      "browser": { "binding": "BROWSER" },
      "kv_namespaces": [{ "binding": "PDF_CACHE", "id": "4d7655bd229b46de895a35756bd52148" }],
      "vars": {
        "NOTIFY_TO": "erik@tcstudio.io",
        "ACCESS_TEAM_DOMAIN": "tcstudio.cloudflareaccess.com",
        "ACCESS_AUD": "REPLACE_WITH_STAGING_ACCESS_AUD"
      }
    }
  }
}
